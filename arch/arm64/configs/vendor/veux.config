# BLAIR Core Architecture & Clocks
CONFIG_ARCH_BLAIR=y
CONFIG_COMMON_CLK_QCOM=y
CONFIG_PINCTRL_BLAIR=y
CONFIG_SM_GCC_BLAIR=y
CONFIG_SM_GPUCC_BLAIR=y
CONFIG_SM_DISPCC_BLAIR=y
CONFIG_SM_DEBUGCC_BLAIR=y
CONFIG_BUILD_ARM64_DT_OVERLAY=y

# First-Boot Diagnostics & Memory (Pstore / Ramoops & ION)
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_COMPRESS=y
CONFIG_PSTORE_DEFLATE_COMPRESS=y
CONFIG_PSTORE_DEFLATE_COMPRESS_DEFAULT=y
CONFIG_PSTORE_COMPRESS_DEFAULT="deflate"
CONFIG_ION=y
CONFIG_ION_SYSTEM_HEAP=y
CONFIG_ION_CMA_HEAP=y

# Core SoC Bus, Power, RPMH, SPMI & Interconnect
CONFIG_QCOM_COMMAND_DB=y
CONFIG_QCOM_RPMH=y
CONFIG_QCOM_RPMHPD=y
CONFIG_QCOM_CLK_RPMH=y
CONFIG_SPMI_MSM_PMIC_ARB=y
CONFIG_MFD_SPMI_PMIC=y
CONFIG_PINCTRL_QCOM_SPMI_PMIC=y
CONFIG_INTERCONNECT_QCOM=y
CONFIG_INTERCONNECT_QCOM_HOLI=y
CONFIG_INTERCONNECT_QCOM_CPUCP_L3=y
# CONFIG_QCOM_MPM is not set
CONFIG_QCOM_IPCC=y
CONFIG_QCOM_SMEM=y
CONFIG_QCOM_SCM=y
CONFIG_QCOM_SOCINFO=y
CONFIG_MSM_QMP=y
CONFIG_ARM_SMMU=y
CONFIG_QTI_IOMMU_SUPPORT=y
CONFIG_QCOM_QFPROM=y
CONFIG_QCOM_QFPROM_SYS=y
CONFIG_HWSPINLOCK_QCOM=y
CONFIG_QCOM_SMP2P=y
CONFIG_QCOM_GLINK=y
CONFIG_RPMSG_QCOM_GLINK_SMEM=y
CONFIG_POWER_RESET_MSM=y
CONFIG_RTC_DRV_PM8XXX=y
CONFIG_INPUT_QPNP_POWER_ON=y

# PMIC & Regulators
CONFIG_REGULATOR_QCOM_RPM=y
CONFIG_REGULATOR_QCOM_RPMH=y
CONFIG_REGULATOR_PROXY_CONSUMER=y
CONFIG_REGULATOR_REFGEN=y
CONFIG_REGULATOR_STUB=y
CONFIG_REGULATOR_QTI_FIXED_VOLTAGE=y
CONFIG_REGULATOR_QPNP_AMOLED=y
CONFIG_REGULATOR_QPNP_LCDB=y

# Display (DRM / MSM SDE)
CONFIG_DRM_MSM=y
CONFIG_DRM_MSM_SDE=y
CONFIG_DRM_MSM_DSI=y
CONFIG_MSM_SDE_ROTATOR=y

# Storage (UFS / MMC)
CONFIG_SCSI=y
CONFIG_SCSI_UFS_QCOM=y
CONFIG_PHY_QCOM_UFS=y
CONFIG_PHY_QCOM_UFS_V3=y
CONFIG_PHY_QCOM_UFS_V4=y
CONFIG_PHY_QCOM_UFS_QRBTC_SDM845=y
CONFIG_MMC_SDHCI_MSM=y
CONFIG_MMC_CQHCI=y
# CONFIG_SCSI_UFS_CRYPTO is not set
# CONFIG_SCSI_UFS_CRYPTO_QTI is not set
# CONFIG_QTI_CRYPTO_COMMON is not set

# Serial, I2C, SPI, DMA (Geni SE)
CONFIG_MSM_GENI_SE=y
CONFIG_SERIAL_MSM_GENI=y
CONFIG_SERIAL_MSM_GENI_CONSOLE=y
CONFIG_I2C_MSM_GENI=y
CONFIG_SPI_MSM_GENI=y
CONFIG_MSM_GPI_DMA=y

# USB & PHYs
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_USB_DWC3_MSM=y
CONFIG_USB_MSM_SSPHY_QMP=y
# CONFIG_MSM_QUSB_PHY is not set
CONFIG_MSM_HSUSB_PHY=y
CONFIG_USB_QCOM_EMU_PHY=y
CONFIG_NOP_USB_XCEIV=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_F_FS=y
CONFIG_USB_CONFIGFS_F_DIAG=y
CONFIG_USB_CONFIGFS_F_CDEV=y
CONFIG_QPNP_USB_PDPHY=y
CONFIG_USB_PD_POLICY=y

# Thermal, ADC & NVRAM
CONFIG_QCOM_SPMI_ADC5=y
CONFIG_QCOM_SPMI_TEMP_ALARM=y
CONFIG_NVMEM_SPMI_SDAM=y

# Subsystem Restart & IPC
CONFIG_QRTR=y
CONFIG_QRTR_SMD=y
CONFIG_MSM_SUBSYSTEM_RESTART=y
# CONFIG_MSM_PIL_SSR_GENERIC is not set
CONFIG_MSM_SERVICE_LOCATOR=y
CONFIG_MSM_SERVICE_NOTIFIER=y

# Security, Crypto & SCM
CONFIG_CRYPTO_DEV_QCOM_MSM_QCE=y
CONFIG_CRYPTO_DEV_QCEDEV=y
CONFIG_QSEECOM=y
CONFIG_QCOM_SMCINVOKE=y
CONFIG_QCOM_SECURE_BUFFER=y

# Backlight & LEDs
CONFIG_BACKLIGHT_QCOM_SPMI_WLED=y
CONFIG_LEDS_QTI_TRI_LED=y
CONFIG_PWM_QTI_LPG=y

# CPU Frequency & Thermal Governors
# CONFIG_ARM_QCOM_CPUFREQ_HW is not set
CONFIG_DEVFREQ_GOV_QCOM_ADRENO_TZ=y
CONFIG_DEVFREQ_GOV_QCOM_GPUBW_MON=y

# Disable Subsystems Not Needed for First Boot
# CONFIG_SPECTRA_CAMERA is not set
# CONFIG_MSM_CAMERA is not set
# CONFIG_SND_SOC is not set
# CONFIG_AUDIO_QGKI is not set
# CONFIG_QCACLD_WLAN is not set
# CONFIG_WLAN is not set
# CONFIG_IPA is not set
# CONFIG_IPA3 is not set
# CONFIG_MSM_VIDEO is not set
# CONFIG_MSM_CVP is not set
# CONFIG_NFC is not set

# LTO Configuration (ThinLTO matches Qualcomm 5.10 and fits CI runner memory)
CONFIG_LTO=y
CONFIG_LTO_CLANG=y
# CONFIG_LTO_CLANG_FULL is not set
CONFIG_LTO_CLANG_THIN=y
# CONFIG_LTO_NONE is not set
# CONFIG_INPUT_FINGERPRINT is not set
# CONFIG_FINGERPRINT_FPC is not set
# CONFIG_FINGERPRINT_GOODIX_FOD is not set
# CONFIG_FINGERPRINT_SILEAD is not set
# CONFIG_CHARGER_LN8000 is not set
# CONFIG_CHARGER_SC8551 is not set
# CONFIG_FUEL_GAUGE_BQ27Z561 is not set
# CONFIG_AWINIC_HAPTIC_NV is not set
# CONFIG_KSU is not set
# CONFIG_LRU_GEN is not set
# CONFIG_SCHED_CASS is not set
